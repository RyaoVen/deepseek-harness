{
  "name": "@deepseek-ai/dsh-desktop",
  "description": "Desktop shell: runs `dsh --profile web` and shows the Web GUI in a native window.",
  "version": "0.1.0-rc.6",
  "private": true,
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "workspace:*"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tsx": "^4.19.0"
  },
  "build": {
    "appId": "com.deepseek.harness.desktop",
    "productName": "DeepSeek Harness",
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "node_modules/@deepseek-ai/dsh",
        "to": "dsh-cli"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
